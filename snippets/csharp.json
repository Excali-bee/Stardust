{
    "Create Item": {
        "prefix": "sd:item",
        "body": [
            "\tusing Terraria;",
            "\tusing Terraria.ModLoader;",
            "\t",
            "\tnamespace $WORKSPACE_NAME.$1",
            "\t{",
            "\t\tpublic class $TM_FILENAME_BASE : ModItem",
            "\t\t{",
            "\t\t\tpublic override void SetDefaults()",
            "\t\t\t{",
            "\t\t\t\titem.width = 8;",
            "\t\t\t\titem.height = 8;",
            "\t\t\t}",
            "\t\t}",
            "\t}"
        ]
    },
    "Create Projectile": {
        "prefix": "sd:proj",
        "body": [
            "\tusing Terraria;",
            "\tusing Terraria.GameContent;",
            "\tusing Terraria.ID;",
            "\tusing Terraria.ModLoader;",
            "\t",
            "\tnamespace $WORKSPACE_NAME.$1",
            "\t{",
            "\t\tpublic class $TM_FILENAME_BASE : ModProjectile",
            "\t\t{",
            "\t\t\tpublic override void SetDefaults()",
            "\t\t\t{",
            "\t\t\t\tProjectile.width = 8;",
            "\t\t\t\tProjectile.height = 8;",
            "\t\t\t\tProjectile.aiStyle = 1;",
            "\t\t\t\tProjectile.friendly = true;",
            "\t\t\t\tProjectile.hostile = false;",
            "\t\t\t\tProjectile.DamageType = DamageClass.Ranged;",
            "\t\t\t\tProjectile.penetrate = 5;",
            "\t\t\t\tProjectile.timeLeft = 600;",
            "\t\t\t\tProjectile.alpha = 255;",
            "\t\t\t\tProjectile.light = 0.5f;",
            "\t\t\t\tProjectile.ignoreWater = true;",
            "\t\t\t\tProjectile.tileCollide = true;",
            "\t\t\t\tProjectile.extraUpdates = 1;",
            "\t\t\t\tAIType = ProjectileID.Bullet;",
            "\t\t\t}",
            "\t\t}",
            "\t}"
        ]
    },
    "Create Dust": {
        "prefix": "sd:dust",
        "body": [
            "\tusing Terraria;",
            "\tusing Terraria.ModLoader;",
            "\t",
            "\tnamespace $WORKSPACE_NAME.$1",
            "\t{",
            "\t\tpublic class $TM_FILENAME_BASE : ModDust",
            "\t\t{",
            "\t\t\tpublic override void OnSpawn(Dust dust) {",
            "\t\t\t\tdust.velocity *= 0.4f; // Multiply the dust's start velocity by 0.4, slowing it down",
            "\t\t\t\tdust.noGravity = true; // Makes the dust have no gravity.",
            "\t\t\t\tdust.noLight = true; // Makes the dust emit no light.",
            "\t\t\t\tdust.scale *= 1.5f; // Multiplies the dust's initial scale by 1.5.",
            "\t\t\t}",
            "\t\t\t",
            "\t\t\tpublic override bool Update(Dust dust) { // Calls every frame the dust is active",
            "\t\t\t\treturn false; // Return false to prevent vanilla behavior.",
            "\t\t\t}",
            "\t\t}",
            "\t}"
        ]
    },
    "Create Tile": {
        "prefix": "sd:tile",
        "body": [
            "\tusing Microsoft.Xna.Framework;",
            "\tusing Terraria;",
            "\tusing Terraria.ModLoader;",
            "\t",
            "\tnamespace $WORKSPACE_NAME.$1",
            "\t{",
            "\t\tpublic class $TM_FILENAME_BASE : ModTile",
            "\t\t{",
            "\t\t\tpublic override void SetStaticDefaults() {",
            "\t\t\t\tMain.tileSolid[Type] = true;",
            "\t\t\t\tMain.tileMergeDirt[Type] = true;",
            "\t\t\t\tMain.tileBlockLight[Type] = true;",
            "\t\t\t",
            "\t\t\t\tDustType = ModContent.DustType<$3>();",
            "\t\t\t",
            "\t\t\t\tAddMapEntry(new Color(200, 200, 200));",
            "\t\t\t}",
            "\t\t\t",
            "\t\t\tpublic override void NumDust(int i, int j, bool fail, ref int num) {",
            "\t\t\t\tnum = fail ? 1 : 3;",
            "\t\t\t}",
            "\t\t}",
            "\t}"
        ]
    },
    "Create Rarity": {
        "prefix": "sd:rarity",
        "body": [
            "\tusing Microsoft.Xna.Framework;",
            "\tusing Terraria.ModLoader;",
            "\tnamespace $WORKSPACE_NAME.$1",
            "\t{",
            "\t\tpublic class $TM_FILENAME_BASE : ModRarity",
            "\t\t{",
            "\t\t\tpublic override Color RarityColor => new Color(200, 215, 230);",
            "\t\t}",
            "\t}"
        ]
    },
    "Create Wing": {
        "prefix": "sd:wing",
        "body": [
            "\tusing System.Linq;",
            "\tusing Terraria;",
            "\tusing Terraria.DataStructures;",
            "\tusing Terraria.ID;",
            "\tusing Terraria.ModLoader;",
            "\t",
            "\tnamespace $WORKSPACE_NAME.$1",
            "\t{",
            "\t\t[AutoloadEquip(EquipType.Wings)]",
            "\t\tpublic class $2 : ModItem",
            "\t\t{",
            "\t\t\t",
            "\t\t\tpublic override void SetStaticDefaults() {",
            "\t\t\t\t// Fly time: 180 ticks = 3 seconds",
            "\t\t\t\t// Fly speed: 9",
            "\t\t\t\t// Acceleration multiplier: 2.5",
            "\t\t\t\tArmorIDs.Wing.Sets.Stats[Item.wingSlot] = new WingStats(180, 9f, 2.5f);",
            "\t\t\t}",
            "\t\t\t",
            "\t\t\tpublic override void SetDefaults() {",
            "\t\t\t\tItem.width = 22;",
            "\t\t\t\tItem.height = 20;",
            "\t\t\t\tItem.value = 10000;",
            "\t\t\t\tItem.rare = ItemRarityID.Green;",
            "\t\t\t\tItem.accessory = true;",
            "\t\t\t}",
            "\t\t\t",
            "\t\t\tpublic override void VerticalWingSpeeds(Player player, ref float ascentWhenFalling, ref float ascentWhenRising,",
            "\t\t\t\tref float maxCanAscendMultiplier, ref float maxAscentMultiplier, ref float constantAscend) {",
            "\t\t\t\tascentWhenFalling = 0.85f; // Falling glide speed",
            "\t\t\t\tascentWhenRising = 0.15f; // Rising speed",
            "\t\t\t\tmaxCanAscendMultiplier = 1f;",
            "\t\t\t\tmaxAscentMultiplier = 3f;",
            "\t\t\t\tconstantAscend = 0.135f;",
            "\t\t\t}",
            "\t\t}",
            "\t}"
        ]
    },
    "Create Boots": {
        "prefix": "sd:arrow",
        "body": [
            "\tusing Terraria;",
            "\tusing Terraria.ID;",
            "\tusing Terraria.ModLoader;",
            "\t",
            "\tnamespace  $WORKSPACE_NAME.$1",
            "\t{",
            "\t\tpublic class $2 : ModItem",
            "\t\t{",
            "\t\t\tpublic override void SetStaticDefaults()",
            "\t\t\t{",
            "\t\t\t\tItem.ResearchUnlockCount = 99;",
            "\t\t\t}",
            "\t\t\t",
            "\t\t\tpublic override void SetDefaults()",
            "\t\t\t{",
            "\t\t\t\tItem.width = 14;",
            "\t\t\t\tItem.height = 36;",
            "\t\t\t\t",
            "\t\t\t\tItem.damage = 6;",
            "\t\t\t\tItem.DamageType = DamageClass.Ranged;",
            "\t\t\t\t",
            "\t\t\t\tItem.maxStack = Item.CommonMaxStack;",
            "\t\t\t\tItem.consumable = true;",
            "\t\t\t\tItem.knockBack = 1.5f;",
            "\t\t\t\tItem.value = Item.sellPrice(copper: 16);",
            "\t\t\t\tItem.shoot = $3;",
            "\t\t\t\tItem.shootSpeed = 3f;",
            "\t\t\t\tItem.ammo = AmmoID.Arrow;",
            "\t\t\t}",
            "\t\t}",
            "\t}"
        ]
    },
    "Create Buff": {
        "prefix": "sd:buff",
        "body": [
            "\tusing Terraria;",
            "\tusing Terraria.ID;",
            "\tusing Terraria.ModLoader;",
            "\t ",
            "\tnamespace $WORKSPACE_NAME.$1",
            "\t{",
            "\t\tpublic class $2 : ModBuff",
            "\t\t{",
            "\t\t\tpublic override void SetStaticDefaults() {",
            "\t\t\t\tMain.debuff[Type] = true;",
            "\t\t\t\tMain.buffNoSave[Type] = true;",
            "\t\t\t\tMain.buffNoTimeDisplay[Type] = true;",
            "\t\t\t\tBuffID.Sets.NurseCannotRemoveDebuff[Type] = true;",
            "\t\t\t}",
            "\t\t\tpublic override void Update(Player player, ref int buffIndex) {",
            "\t\t\t}",
            "\t\t}",
            "\t}"
        ]
    },
    "New Projectile": {
        "prefix": "sd:new:proj",
        "body": [
            "\tProjectile.NewProjectile($1, $2, $3, $4, $5, %6, %7);"
        ]
    },
    "New Direct Dust": {
        "prefix": "sd:new:ddust",
        "body": [
            "\tDust dust = Dust.NewDustDirect($1, $2, $3, $4);"
        ]
    },
    "New Dust": {
        "prefix": "sd:new:dust",
        "body": [
            "\tDust dust = Dust.NewDust($1, $2, $3, $4);"
        ]
    },
    "Play Sound": {
        "prefix": "sd:playsound",
        "body": [
            "\tSoundEngine.PlaySound($1,$2);"
        ]
    },
    "Add Recipe": {
        "prefix": "sd:recipe",
        "body": [
            "\tpublic override void AddRecipes()",
            "\t{",
            "\t\tCreateRecipe()",
            "\t\t\t.AddIngredient($1, $2)",
            "\t\t\t.AddTile($3)",
            "\t\t\t.Register();",
            "\t}"
        ]
    }
}
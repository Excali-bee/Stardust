    "Create Wing": {
        "prefix": "sd:wing",
        "body": [
            "\tusing System.Linq;",
            "\tusing Terraria;",
            "\tusing Terraria.DataStructures;",
            "\tusing Terraria.ID;",
            "\tusing Terraria.ModLoader;",
            "\t",
            "\tnamespace $WORKSPACE_NAME.$1",
            "\t{",
            "\t\t[AutoloadEquip(EquipType.Wings)]",
            "\t\tpublic class $2 : ModItem",
            "\t\t{",
            "\t\t\t",
            "\t\t\tpublic override void SetStaticDefaults() {",
            "\t\t\t\t// Fly time: 180 ticks = 3 seconds",
            "\t\t\t\t// Fly speed: 9",
            "\t\t\t\t// Acceleration multiplier: 2.5",
            "\t\t\t\tArmorIDs.Wing.Sets.Stats[Item.wingSlot] = new WingStats(180, 9f, 2.5f);",
            "\t\t\t}",
            "\t\t\t",
            "\t\t\tpublic override void SetDefaults() {",
            "\t\t\t\tItem.width = 22;",
            "\t\t\t\tItem.height = 20;",
            "\t\t\t\tItem.value = 10000;",
            "\t\t\t\tItem.rare = ItemRarityID.Green;",
            "\t\t\t\tItem.accessory = true;",
            "\t\t\t}",
            "\t\t\t",
            "\t\t\tpublic override void VerticalWingSpeeds(Player player, ref float ascentWhenFalling, ref float ascentWhenRising,",
            "\t\t\t\tref float maxCanAscendMultiplier, ref float maxAscentMultiplier, ref float constantAscend) {",
            "\t\t\t\tascentWhenFalling = 0.85f; // Falling glide speed",
            "\t\t\t\tascentWhenRising = 0.15f; // Rising speed",
            "\t\t\t\tmaxCanAscendMultiplier = 1f;",
            "\t\t\t\tmaxAscentMultiplier = 3f;",
            "\t\t\t\tconstantAscend = 0.135f;",
            "\t\t\t}",
            "\t\t}",
            "\t}"
        ]
    },
    "Create Arrow": {

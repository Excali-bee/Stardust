        "body": [
            "\tusing Terraria;",
            "\tusing Terraria.ModLoader;",
            "\t",
            "\tnamespace $WORKSPACE_NAME.$1",
            "\t{",
            "\t\tpublic class $TM_FILENAME_BASE : ModItem",
            "\t\t{",
            "\t\t\tpublic override void SetDefaults()",
            "\t\t\t{",
            "\t\t\t\titem.width = 8;",
            "\t\t\t\titem.height = 8;",
            "\t\t\t}",
            "\t\t}",
            "\t}"
        ]
    },
    "Create Projectile": {
        "prefix": "sd:proj",
        "body": [
            "\tusing Terraria;",
            "\tusing Terraria.GameContent;",
            "\tusing Terraria.ID;",
            "\tusing Terraria.ModLoader;",
            "\t",
            "\tnamespace $WORKSPACE_NAME.$1",
            "\t{",
            "\t\tpublic class $TM_FILENAME_BASE : ModProjectile",
            "\t\t{",
            "\t\t\tpublic override void SetDefaults()",
            "\t\t\t{",
            "\t\t\t\tProjectile.width = 8;",
            "\t\t\t\tProjectile.height = 8;",
            "\t\t\t\tProjectile.aiStyle = 1;",
            "\t\t\t\tProjectile.friendly = true;",
            "\t\t\t\tProjectile.hostile = false;",
            "\t\t\t\tProjectile.DamageType = DamageClass.Ranged;",
            "\t\t\t\tProjectile.penetrate = 5;",
            "\t\t\t\tProjectile.timeLeft = 600;",
            "\t\t\t\tProjectile.alpha = 255;",
            "\t\t\t\tProjectile.light = 0.5f;",
            "\t\t\t\tProjectile.ignoreWater = true;",
            "\t\t\t\tProjectile.tileCollide = true;",
            "\t\t\t\tProjectile.extraUpdates = 1;",
            "\t\t\t\tAIType = ProjectileID.Bullet;",
            "\t\t\t}",
            "\t\t}",
            "\t}"
        ]
    },
    "Create Dust": {
        "prefix": "sd:dust",
        "body": [
            "\tusing Terraria;",
            "\tusing Terraria.ModLoader;",
            "\t",
            "\tnamespace $WORKSPACE_NAME.$1",
            "\t{",
            "\t\tpublic class $TM_FILENAME_BASE : ModDust",
            "\t\t{",
            "\t\t\tpublic override void OnSpawn(Dust dust) {",
            "\t\t\t\tdust.velocity *= 0.4f; // Multiply the dust's start velocity by 0.4, slowing it down",
            "\t\t\t\tdust.noGravity = true; // Makes the dust have no gravity.",
            "\t\t\t\tdust.noLight = true; // Makes the dust emit no light.",
            "\t\t\t\tdust.scale *= 1.5f; // Multiplies the dust's initial scale by 1.5.",
            "\t\t\t}",
            "\t\t\t",
            "\t\t\tpublic override bool Update(Dust dust) { // Calls every frame the dust is active",
            "\t\t\t\treturn false; // Return false to prevent vanilla behavior.",
            "\t\t\t}",
            "\t\t}",
            "\t}"
        ]
    },
    "Create Tile": {
        "prefix": "sd:tile",
        "body": [
            "\tusing Microsoft.Xna.Framework;",
            "\tusing Terraria;",
            "\tusing Terraria.ModLoader;",
            "\t",
            "\tnamespace $WORKSPACE_NAME.$1",
            "\t{",
            "\t\tpublic class $TM_FILENAME_BASE : ModTile",
            "\t\t{",
            "\t\t\tpublic override void SetStaticDefaults() {",
            "\t\t\t\tMain.tileSolid[Type] = true;",
            "\t\t\t\tMain.tileMergeDirt[Type] = true;",
            "\t\t\t\tMain.tileBlockLight[Type] = true;",
            "\t\t\t",
            "\t\t\t\tDustType = ModContent.DustType<$3>();",
            "\t\t\t",
            "\t\t\t\tAddMapEntry(new Color(200, 200, 200));",
            "\t\t\t}",
            "\t\t\t",
            "\t\t\tpublic override void NumDust(int i, int j, bool fail, ref int num) {",
            "\t\t\t\tnum = fail ? 1 : 3;",
            "\t\t\t}",
            "\t\t}",
            "\t}"
        ]
    },
